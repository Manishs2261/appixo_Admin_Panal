import 'package:firebase_core/firebase_core.dart';
import 'package:flutter_dotenv/flutter_dotenv.dart';

class DefaultFirebaseConfig {
  static FirebaseOptions get currentPlatform {
    const String environment = String.fromEnvironment('ENV', defaultValue: 'dev');

    return FirebaseOptions(
      apiKey: dotenv.env['API_KEY_${environment.toUpperCase()}'] ?? '',
      authDomain: dotenv.env['AUTH_DOMAIN_${environment.toUpperCase()}'] ?? '',
      projectId: dotenv.env['PROJECT_ID_${environment.toUpperCase()}'] ?? '',
      storageBucket: dotenv.env['STORAGE_BUCKET_${environment.toUpperCase()}'] ?? '',
      messagingSenderId: dotenv.env['MESSAGING_SENDER_ID_${environment.toUpperCase()}'] ?? '',
      appId: dotenv.env['APP_ID_${environment.toUpperCase()}'] ?? '',
      measurementId: dotenv.env['MEASUREMENT_ID_${environment.toUpperCase()}'] ?? '',
    );
  }

  static String environment = const String.fromEnvironment('ENV', defaultValue: 'dev');

  // Firestore Collection Names
  static String get roomCollection => dotenv.env['ROOM_COLLECTION_${environment.toUpperCase()}'] ?? 'DevRoomCollection';
  static String get foodCollection => dotenv.env['FOOD_COLLECTION_${environment.toUpperCase()}'] ?? 'DevFoodCollection';
  static String get sellAndBuyCollection => dotenv.env['SELL_AND_BUY_COLLECTION_${environment.toUpperCase()}'] ?? 'DevSellAndBuyCollection';
  static String get servicesCollection => dotenv.env['SERVICES_COLLECTION_${environment.toUpperCase()}'] ?? 'DevServicesCollection';
}
